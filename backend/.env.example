# Backend environment example
PORT=4000
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>/timecook?retryWrites=true&w=majority&appName=<appName>
JWT_SECRET=change-me-please
# Comma-separated list of allowed origins for CORS (frontend URL)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://your-frontend-domain.netlify.app
